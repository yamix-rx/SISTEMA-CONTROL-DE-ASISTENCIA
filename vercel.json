{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "server.js": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/pdfkit/js/standard-fonts/**,backend/assets/documentos/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
